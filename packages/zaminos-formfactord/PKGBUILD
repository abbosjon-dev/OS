# Maintainer: ZaminOS team
pkgname=zaminos-formfactord
pkgver=0.1.0
pkgrel=1
pkgdesc="Form-factor detection daemon — switches ZaminOS between mobile and desktop modes"
arch=('aarch64')
url="https://github.com/abbosjon-dev/os"
license=('GPL3')
depends=('libinput' 'systemd' 'dbus')
makedepends=('rust' 'cargo')
source=("formfactord-${pkgver}.tar.gz::file://${startdir}/../../formfactord")
sha256sums=('SKIP')

build() {
  cd "${srcdir}/formfactord"
  cargo build --release --locked
}

package() {
  cd "${srcdir}/formfactord"
  install -Dm755 target/release/zamin-formfactord \
    "${pkgdir}/usr/bin/zamin-formfactord"
  install -Dm644 data/zamin-formfactord.service \
    "${pkgdir}/usr/lib/systemd/system/zamin-formfactord.service"
  install -Dm644 data/99-zamin-formfactor.rules \
    "${pkgdir}/usr/lib/udev/rules.d/99-zamin-formfactor.rules"
}
